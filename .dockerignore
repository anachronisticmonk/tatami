# The build context must not carry 1.5 GB of generated corpus. small.json is
# the exception -- it is what the container serves.
corpus/*
!corpus/small.json

_build
.git
.lake
*.pdf
*.tsv

# The Lean sources are IN the context now: the image builds the generator as
# well as the servers, so the playground's /translate reaches the real binary
# rather than falling back to the page's own JavaScript. They used to be
# excluded, back when the image was the OCaml half alone.
