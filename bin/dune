; One stanza per executable. A single (executables) stanza links every listed
; module into every binary, so each one would run the others' top-level effects.

(executable
 (name gen_corpus)
 (modules gen_corpus)
 (libraries unix))

(executable
 (name verify)
 (modules verify)
 (libraries tatami unix yojson pgx pgx_unix))

(executable
 (name bench)
 (modules bench)
 (libraries tatami rowmajor columnar unix))

(executable
 (name serve)
 (modules serve)
 (libraries tatami rowmajor columnar tiny_httpd yojson unix))

(executable
 (name load)
 (modules load)
 (libraries tatami rows shred unix yojson pgx pgx_unix))
